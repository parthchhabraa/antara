# ==============================================================================
# ANTARA PERSISTENT STATE REMEMBER FILE (/root/antara/.env-remember)
# NON-SECRET CONFIGURATION & SYSTEM ARCHITECTURE STATE
# DO NOT STORE API KEYS, SECRETS, OR SERVICE ACCOUNT PRIVATE KEYS HERE.
# ==============================================================================

# Project Metadata
PROJECT_NAME="Antara"
PROJECT_ID="antara-moneycontrol"
DEPLOYMENT_TARGET="Ubuntu Server"
SERVICE_SYSTEMD_NAME="antara-ml.service"
SERVICE_RESTART_CMD="systemctl restart antara-ml.service"

# Port Allocations (Strictly enforce no overlaps)
PORT_RESERVED_PAGES_1=5000     # Existing webpage service (DO NOT TOUCH)
PORT_RESERVED_PAGES_2=8000     # Existing webpage service (DO NOT TOUCH)
PORT_ANTARA_ML_API=8001        # Antara FastAPI ML backend (LOCKED)

# Networking & Cloudflare Named Tunnel
CLOUDFLARE_TUNNEL_TYPE="NAMED_PERSISTENT"
CLOUDFLARE_TUNNEL_NAME="antara-ml-tunnel"
CLOUDFLARE_TUNNEL_HOSTNAME="ml.antara.app"
CLOUDFLARE_CONFIG_PATH="/etc/cloudflared/config.yml"
TAILSCALE_STATUS="Active - independent daemon, no port overlap"

# ML Pipeline & Cold-Start Rules
ML_COLD_START_DAY_THRESHOLD=14 # Users with <14 days of data use rule-based category medians
ML_MODEL_MODE_HEURISTIC="HEURISTIC_COLD_START"
ML_MODEL_MODE_TRAINED="TRAINED_EMBEDDING_V1"

# Firebase & Database State
FIRESTORE_SCHEMA_VERSION="v1"
COLLECTION_USERS="users"
COLLECTION_USER_TRANSACTIONS="transactions"
COLLECTION_CATEGORIES="categories"
COLLECTION_PREDICTIONS="predictions"
DOC_BETA_ALLOWLIST="admin/betaAllowlist"

# Seeded Indian Teen Categories (12 Total)
CATEGORIES_SEEDED="food-delivery, mobile-recharge, subscriptions, gaming, transport, fashion, education, personal-care, social-gifts, stationery, savings, miscellaneous"

# Custom Auth Claims
SUPERADMIN_EMAIL="parthchhabra6112@gmail.com"
SUPERADMIN_CLAIM_KEY="role"
SUPERADMIN_CLAIM_VALUE="superadmin"

# Last Known Good Service Status
ML_SERVICE_STATUS="Healthy"
LAST_VALIDATED_TIMESTAMP="2026-08-19T22:58:00+05:30"
