rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if caller is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Superadmin check via Custom Firebase Auth Claim
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    // Social feature: true when the caller is a real, currently-friended
    // account of `ownerUserId` — checked by looking the caller's own uid
    // up in `ownerUserId`'s own friends subcollection. Friendships are
    // always written both directions in the same atomic batch (see
    // backend/app/social.py — a normal client can only ever write to its
    // *own* friends subcollection per the rule below, never someone
    // else's, which is exactly why that mutual write has to happen
    // server-side), so checking just this one direction is sufficient and
    // can never be asymmetric in practice.
    function isFriend(ownerUserId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(ownerUserId)/friends/$(request.auth.uid));
    }

    // Beta allowlist check — Brief 2 (2026-09-04): this used to do a
    // get() on admin/betaAllowlist directly (billed on every single
    // transaction write, and rules cap out at 10 get()s/request) and
    // required that document be readable by any authenticated user so the
    // client could run the equivalent check itself — which also handed
    // every beta tester's email address to every other signed-in account,
    // including the very first stranger public signup would let in.
    // Membership is now resolved server-side instead (POST
    // /api/v1/auth/sync-claims, via the Admin SDK) and stamped onto the
    // caller's own ID token as a custom claim at sign-in; this is now a
    // free token check, and admin/betaAllowlist's own read rule below is
    // superadmin-only. isPublicSignupEnabled() below still does a get() —
    // deliberately left as-is for now (see its own comment).
    function isBetaAllowlisted() {
      return isAuthenticated() && request.auth.token.beta == true;
    }

    // Step 12: public-launch toggle. Defaults closed (missing doc, or the
    // field itself missing/false, all read as "not enabled") — this is the
    // actual enforcement point, not just the client-side UI gate in
    // AuthContext.tsx. A user let into "Live Mode" by the client without
    // also passing this (or isBetaAllowlisted()) still can't write real
    // transactions; the two gates are independent and this one can't be
    // bypassed by editing client code.
    // Cost note (Brief 2, 2026-09-04): still a get() per write, unlike
    // isBetaAllowlisted() above. Left as-is deliberately for this brief —
    // admin/launchConfig's read rule has to stay open to any authenticated
    // user anyway (a brand-new, possibly not-yet-allowlisted sign-in needs
    // to read it to find out whether public signup is even on), so there's
    // no matching leak to close here the way there was for betaAllowlist,
    // and folding this into a custom claim too would mean re-syncing every
    // signed-in user's claims the moment a superadmin flips the toggle,
    // which a claim (only refreshed at sign-in) can't do live. Revisit if
    // this get() actually shows up in cost, not preemptively.
    function isPublicSignupEnabled() {
      return exists(/databases/$(database)/documents/admin/launchConfig) &&
        get(/databases/$(database)/documents/admin/launchConfig).data.publicSignupEnabled == true;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Transactions subcollection: a valid token + ownership is not enough on
      // its own - the caller must also be on the beta allowlist OR public
      // signup must be enabled (superadmin always bypasses, matching
      // isSuperAdmin() elsewhere in this file). Beta-allowlist gating code is
      // untouched by Step 12 — this only adds an additional, independently
      // toggled path in, exactly as the brief asked ("don't delete the
      // beta-allowlist gating code").
      match /transactions/{txId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if isSuperAdmin() || (isOwner(userId) && (isBetaAllowlisted() || isPublicSignupEnabled()));
      }

      // "Instances" (named budget-allocation profiles, lib/api.ts's
      // BudgetInstance) — same ownership rule as the parent profile doc
      // itself, no separate allowlist/public-signup gate needed: reaching
      // this UI at all already means the caller has a real signed-in
      // profile, which already required clearing those gates elsewhere.
      match /instances/{instanceId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }

      // Wallets — real named balances (types/index.ts's Wallet). Same
      // ownership-only rule as instances above: no separate allowlist gate,
      // same reasoning (reaching this UI already means a real signed-in
      // profile). Client writes (create/rename/archive, and the balance
      // debit/credit inside addLiveTransaction/deleteLiveTransaction/
      // updateLiveTransaction/logIncome's Firestore transactions in
      // lib/api.ts) all go through this same rule — there is no
      // Admin-SDK-only path for wallet balance changes, unlike
      // /predictions above.
      match /wallets/{walletId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }

      // Income (types/index.ts's IncomeEntry) — deliberately its own
      // collection, not the transactions one above, so it gets its own
      // rule rather than inheriting transactions' beta-allowlist/public-
      // signup gate. Same ownership-only shape as instances/wallets: an
      // account that can already reach this UI has already cleared those
      // gates elsewhere (ConsentGate/allowlist check happens once, at
      // sign-in, not per-collection).
      match /income/{incomeId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }

      // Friends — a user's own friend list is their own to read, never
      // public, never friend-of-a-friend readable. Write is owner-only
      // too: a real mutual friendship is only ever created/removed via
      // the backend (POST /api/v1/social/add-friend, /unfriend), which
      // uses the Admin SDK and so bypasses this rule entirely on both
      // sides of the write — this owner-only client rule exists so a
      // signed-in user can still read (list) their own friends directly,
      // and defensively, not as the actual mechanism friendships get
      // created through.
      match /friends/{friendUid} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }

      // Badges (types/index.ts's Badge — includes the "profile" and
      // "archetype" summary docs the friend-view profile screen reads,
      // not just achievement badges) — THE one collection in this app
      // that's readable by someone other than its owner. Deliberately
      // narrow: real friends only (isFriend, defined above), never a
      // public or "any authenticated user" rule — archetype/streak/badge
      // data is the one thing this app is willing to show a friend, and
      // nothing here is ever a rupee figure (see app/social.py's own
      // header comment) or budget/cap/wallet/instance data, which all
      // stay on the untouched owner-only collections above. Write stays
      // owner-only — a badge is only ever earned/synced by the account
      // that earned it.
      match /badges/{badgeId} {
        allow read: if isOwner(userId) || isSuperAdmin() || isFriend(userId);
        allow write: if isOwner(userId) || isSuperAdmin();
      }
    }

    // Shared category taxonomy
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ML Predictions (written by backend server/Admin SDK, read-only to user)
    match /predictions/{userId}/{period=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isSuperAdmin(); // Server writes via Admin SDK (bypasses rules) or superadmin token
    }

    // Admin Beta Allowlist — Brief 2 (2026-09-04): was `if isAuthenticated()`,
    // meaning any signed-in account (including a brand-new public signup)
    // could read this document straight out of the browser console and get
    // every beta tester's email address in one call. The client no longer
    // needs to read this at all (see isBetaAllowlisted() above), so this is
    // now superadmin-only in both directions.
    match /admin/betaAllowlist {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Step 12: public-launch config. Readable by any authenticated user —
    // has to be, since a brand-new (possibly not-yet-allowlisted) sign-in
    // needs to read this doc to find out whether they're let in via the
    // public path, before we know anything else about them. Same read
    // posture as admin/betaAllowlist above for the same reason. Write is
    // superadmin-only. Deliberately its own doc, not folded into
    // admin/dataConfig (Step 10, superadmin-read-only ML training config) —
    // that doc's read rule is superadmin-only, which would make it
    // unreadable by exactly the users who need to check this flag.
    match /admin/launchConfig {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Public, anonymous spend survey (feeds ML training data).
    // No auth required to submit — respondents are teens filling out a
    // one-off form, not logged-in users. Write-only: nobody but a
    // superadmin can read, edit, or delete responses back out, so a
    // submission can't be enumerated, scraped, or tampered with after
    // the fact from the client.
    //
    // Step 10 (2026-08-21): this block was found already deployed live in
    // Firebase (ruleset 3bc866e4, created 2026-08-21T08:26:05Z by the
    // separate survey.antara.money project's own setup) but was NOT present
    // in this repo's firestore.rules — the repo file was out of sync with
    // what's actually enforced in production. Pulled it in verbatim here so
    // the repo stops lying about what's live, rather than silently leaving
    // the drift in place.
    function isValidSurveySubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly(
        ['schema_version', 'submitted_at', 'demographics', 'habits', 'category_spend', 'other_spend_note', 'beta_email', 'meta']
      )
        && d.schema_version is int
        && d.submitted_at == request.time
        && d.demographics is map
        && d.habits is map
        && d.category_spend is map
        && d.category_spend.size() <= 25
        && (d.other_spend_note == null || (d.other_spend_note is string && d.other_spend_note.size() <= 300))
        && (d.beta_email == null || (d.beta_email is string && d.beta_email.size() <= 200))
        && d.meta is map;
    }

    match /survey_responses/{responseId} {
      allow create: if isValidSurveySubmission();
      allow read, update, delete: if isSuperAdmin();
    }

    // Step 10: superadmin "tailor the data" config (income band cutoffs,
    // per-category trust weights, outlier handling, confidence threshold —
    // see backend/app/ml/survey_etl.py) and the computed Stage-1 training
    // stats it produces. Both superadmin-only in both directions — the
    // computed stats aren't public data, and only a superadmin should be
    // able to change what feeds the ML heuristic. The backend itself reads/
    // writes both via the Admin SDK, which bypasses these rules entirely;
    // they matter for the admin panel's direct client-side reads.
    match /admin/dataConfig {
      allow read, write: if isSuperAdmin();
    }
    match /admin/categoryBenchmarks {
      allow read, write: if isSuperAdmin();
    }
  }
}
