rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if caller is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Superadmin check via Custom Firebase Auth Claim
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    // Social feature: true when the caller is a real, currently-friended
    // account of `ownerUserId` — checked by looking the caller's own uid
    // up in `ownerUserId`'s own friends subcollection. Friendships are
    // always written both directions in the same atomic batch (see
    // backend/app/social.py — a normal client can only ever write to its
    // *own* friends subcollection per the rule below, never someone
    // else's, which is exactly why that mutual write has to happen
    // server-side), so checking just this one direction is sufficient and
    // can never be asymmetric in practice.
    function isFriend(ownerUserId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(ownerUserId)/friends/$(request.auth.uid));
    }

    // Beta allowlist check — Brief 2 (2026-09-04): this used to do a
    // get() on admin/betaAllowlist directly (billed on every single
    // transaction write, and rules cap out at 10 get()s/request) and
    // required that document be readable by any authenticated user so the
    // client could run the equivalent check itself — which also handed
    // every beta tester's email address to every other signed-in account,
    // including the very first stranger public signup would let in.
    // Membership is now resolved server-side instead (POST
    // /api/v1/auth/sync-claims, via the Admin SDK) and stamped onto the
    // caller's own ID token as a custom claim at sign-in; this is now a
    // free token check, and admin/betaAllowlist's own read rule below is
    // superadmin-only. isPublicSignupEnabled() below still does a get() —
    // deliberately left as-is for now (see its own comment).
    function isBetaAllowlisted() {
      return isAuthenticated() && request.auth.token.beta == true;
    }

    // Step 12: public-launch toggle. Defaults closed (missing doc, or the
    // field itself missing/false, all read as "not enabled") — this is the
    // actual enforcement point, not just the client-side UI gate in
    // AuthContext.tsx. A user let into "Live Mode" by the client without
    // also passing this (or isBetaAllowlisted()) still can't write real
    // transactions; the two gates are independent and this one can't be
    // bypassed by editing client code.
    // Cost note (Brief 2, 2026-09-04): still a get() per write, unlike
    // isBetaAllowlisted() above. Left as-is deliberately for this brief —
    // admin/launchConfig's read rule has to stay open to any authenticated
    // user anyway (a brand-new, possibly not-yet-allowlisted sign-in needs
    // to read it to find out whether public signup is even on), so there's
    // no matching leak to close here the way there was for betaAllowlist,
    // and folding this into a custom claim too would mean re-syncing every
    // signed-in user's claims the moment a superadmin flips the toggle,
    // which a claim (only refreshed at sign-in) can't do live. Revisit if
    // this get() actually shows up in cost, not preemptively.
    function isPublicSignupEnabled() {
      return exists(/databases/$(database)/documents/admin/launchConfig) &&
        get(/databases/$(database)/documents/admin/launchConfig).data.publicSignupEnabled == true;
    }

    // Brief 3 (2026-09-05): field validation, shared across the collections
    // below. Before this, ownership + the beta-allowlist/public-signup gate
    // was the *only* check on a transaction write — nothing stopped
    // `amount: 1e308`, a 900KB note, an unknown category id, or a
    // timestamp in 2077, any of which would poison calculateBurnMetrics
    // and the ML engine (and the large ones cost real Firestore storage/
    // read money). This is the source of truth for what a valid document
    // looks like in each collection.
    //
    // Checked against every real document already in production before
    // deploying this (22 transactions, 6 wallets, 1 income doc, across all
    // 6 real Firebase Auth users that exist today; 0 instances docs exist
    // yet) — all pass unchanged. See REVIEW.md for the actual counts.

    // The 18 real category ids — used both for a transaction's own
    // `category` field and for the keys of an Instance's `pinned` map,
    // kept as one function so the two call sites can't drift from each
    // other. frontend/src/lib/constants.ts's STARTER_CATEGORIES is the
    // real source of truth; rules can't import application code, so this
    // has to be kept in sync by hand if a category is ever added, removed,
    // or renamed there.
    function validCategoryIds() {
      return [
        'food-snacks', 'dates-outings', 'clothes-shoes', 'gifting-friends',
        'fitness', 'transportation', 'grooming', 'subscriptions',
        'movies-entertainment', 'tech-gadgets', 'gaming-inapp', 'investments',
        'charity-donations', 'mobile-recharge', 'books', 'fantasy-betting',
        'tuition-coaching', 'miscellaneous'
      ];
    }

    function isValidCategoryId(id) {
      return id in validCategoryIds();
    }

    // Every real transaction/income doc in production stores `timestamp`
    // as a plain ISO string (confirmed directly against all 22 real
    // transaction docs — 22/22 were `str`, 0 were a native Firestore
    // Timestamp) — that's what every client write path produces
    // (Transaction.timestamp is typed `string`, never `serverTimestamp()`).
    // Both shapes are still accepted here per the brief, defensively, for
    // any future write path that might use a native Timestamp instead.
    //
    // The "not more than 24h in the future" bound can only be enforced
    // exactly for the `timestamp`-typed branch: the rules language has no
    // way to parse an arbitrary ISO string into a comparable timestamp (no
    // parse/strptime equivalent), so a string can only be shape-checked
    // (a `matches()` regex), not numerically bounded against `request.time`.
    // Flagging this rather than silently pretending the string branch gets
    // the same guarantee — if exact future-dating enforcement against
    // string timestamps ever matters, it needs a Cloud Function trigger,
    // not a rule.
    function isValidTimestamp(ts) {
      return (ts is string && ts.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z?$'))
        || (ts is timestamp && ts <= request.time + duration.value(24, 'h'));
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Brief 3: real transaction shape. amount must be positive and capped
      // (a teen logging a ten-lakh expense is a bug or an attack, not a use
      // case — wallet *balances* are allowed to go negative below, this is
      // the transaction amount itself, which never is); category must be
      // one of the 18 real ids; note/subcategory/source/wallet_id are all
      // optional but bounded/typed when present; no undeclared keys
      // (hasOnly) — matches exactly the field set addLiveTransaction/
      // updateLiveTransaction in lib/api.ts ever write (amount, category,
      // subcategory, note, timestamp, source, wallet_id; `id` is the
      // document's own Firestore id, never a stored field).
      function isValidTransaction() {
        let d = request.resource.data;
        return d.keys().hasAll(['amount', 'category', 'timestamp'])
          && d.keys().hasOnly(['amount', 'category', 'subcategory', 'note', 'timestamp', 'source', 'wallet_id'])
          && d.amount is number && d.amount > 0 && d.amount <= 1000000
          && d.category is string && isValidCategoryId(d.category)
          && isValidTimestamp(d.timestamp)
          && (!('subcategory' in d) || (d.subcategory is string && d.subcategory.size() <= 100))
          && (!('note' in d) || (d.note is string && d.note.size() <= 280))
          && (!('source' in d) || d.source in ['upi', 'cash', 'card', 'manual'])
          && (!('wallet_id' in d) || (d.wallet_id is string && d.wallet_id.size() > 0 && d.wallet_id.size() <= 200));
      }

      // Transactions subcollection: a valid token + ownership is not enough on
      // its own - the caller must also be on the beta allowlist OR public
      // signup must be enabled (superadmin always bypasses, matching
      // isSuperAdmin() elsewhere in this file). Beta-allowlist gating code is
      // untouched by Step 12 — this only adds an additional, independently
      // toggled path in, exactly as the brief asked ("don't delete the
      // beta-allowlist gating code"). Brief 3 adds isValidTransaction() on
      // top of the existing gate for a non-superadmin write — superadmin
      // keeps its existing unconditional bypass (matches every other
      // collection's superadmin-bypass posture in this file; a superadmin
      // fixing a malformed doc by hand shouldn't be validated against the
      // same shape a normal client is trusted to already produce).
      // Brief 3: `allow write` used to cover create/update/delete together
      // with the same condition — adding isValidTransaction() to that
      // combined rule would break deleteLiveTransaction (lib/api.ts): a
      // delete request has no request.resource.data at all, so evaluating
      // isValidTransaction() against one errors out and denies the delete.
      // Validation only makes sense for create/update; delete keeps the
      // original ownership+gate check with no shape validation (there's no
      // shape to validate — the document is going away).
      match /transactions/{txId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow create, update: if isSuperAdmin() ||
          (isOwner(userId) && (isBetaAllowlisted() || isPublicSignupEnabled()) && isValidTransaction());
        allow delete: if isSuperAdmin() || (isOwner(userId) && (isBetaAllowlisted() || isPublicSignupEnabled()));
      }

      // Brief 3: saveInstance (lib/api.ts) writes name/pinned/created_at/
      // updated_at — pinned is a category_id -> amount map the user builds
      // by hand, so its keys need the same 18-id check as a transaction's
      // category, and its size is bounded the same way survey_responses'
      // category_spend already is elsewhere in this file. No documents
      // exist in this collection in production yet (checked directly), so
      // this couldn't be checked against real data the way transactions/
      // wallets/income were — only against saveInstance's own write shape.
      function isValidInstance() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'pinned', 'created_at', 'updated_at'])
          && d.keys().hasOnly(['name', 'pinned', 'created_at', 'updated_at'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.pinned is map && d.pinned.size() <= 25 && d.pinned.keys().hasOnly(validCategoryIds())
          && d.created_at is string && d.updated_at is string;
      }

      // "Instances" (named budget-allocation profiles, lib/api.ts's
      // BudgetInstance) — same ownership rule as the parent profile doc
      // itself, no separate allowlist/public-signup gate needed: reaching
      // this UI at all already means the caller has a real signed-in
      // profile, which already required clearing those gates elsewhere.
      // Brief 3: create/update now also require isValidInstance(); delete
      // (deleteInstance in lib/api.ts is a real hard delete here, unlike
      // wallets/income below) stays shape-free, same reasoning as
      // transactions' delete split above.
      match /instances/{instanceId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow create, update: if (isOwner(userId) && isValidInstance()) || isSuperAdmin();
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // Brief 3: createWallet/renameWallet/archiveWallet (lib/api.ts) write
      // name/balance/created_at/archived. Unlike a transaction *amount*,
      // a wallet's real running balance is allowed to go negative (a wallet
      // with more spent from it than was ever logged in, e.g. cash the
      // teen already had before using Antara) — bounded in magnitude on
      // both sides rather than floored at 0.
      function isValidWallet() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'balance', 'created_at', 'archived'])
          && d.keys().hasOnly(['name', 'balance', 'created_at', 'archived'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.balance is number && d.balance >= -1000000 && d.balance <= 1000000
          && d.created_at is string
          && d.archived is bool;
      }

      // Wallets — real named balances (types/index.ts's Wallet). Same
      // ownership-only rule as instances above: no separate allowlist gate,
      // same reasoning (reaching this UI already means a real signed-in
      // profile). Client writes (create/rename/archive, and the balance
      // debit/credit inside addLiveTransaction/deleteLiveTransaction/
      // updateLiveTransaction/logIncome's Firestore transactions in
      // lib/api.ts) all go through this same rule — there is no
      // Admin-SDK-only path for wallet balance changes, unlike
      // /predictions above. Brief 3: create/update also require
      // isValidWallet(); delete kept shape-free (no client path deletes a
      // wallet today — archiveWallet is a soft-delete update — but split
      // the same way as the other collections defensively, same reasoning
      // as transactions' delete split above).
      match /wallets/{walletId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow create, update: if (isOwner(userId) && isValidWallet()) || isSuperAdmin();
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // Brief 3: logIncome (lib/api.ts) writes amount/source/timestamp/
      // wallet_id — wallet_id is required here, unlike a transaction's
      // (see IncomeEntry in types/index.ts: "always required, unlike
      // Transaction.wallet_id").
      function isValidIncome() {
        let d = request.resource.data;
        return d.keys().hasAll(['amount', 'timestamp', 'wallet_id'])
          && d.keys().hasOnly(['amount', 'source', 'timestamp', 'wallet_id'])
          && d.amount is number && d.amount > 0 && d.amount <= 1000000
          && isValidTimestamp(d.timestamp)
          && (!('source' in d) || (d.source is string && d.source.size() <= 100))
          && d.wallet_id is string && d.wallet_id.size() > 0 && d.wallet_id.size() <= 200;
      }

      // Income (types/index.ts's IncomeEntry) — deliberately its own
      // collection, not the transactions one above, so it gets its own
      // rule rather than inheriting transactions' beta-allowlist/public-
      // signup gate. Same ownership-only shape as instances/wallets: an
      // account that can already reach this UI has already cleared those
      // gates elsewhere (ConsentGate/allowlist check happens once, at
      // sign-in, not per-collection). Brief 3: create/update also require
      // isValidIncome(); delete kept shape-free (no client path deletes an
      // income entry today, same defensive split as the other collections).
      match /income/{incomeId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow create, update: if (isOwner(userId) && isValidIncome()) || isSuperAdmin();
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // Friends — a user's own friend list is their own to read, never
      // public, never friend-of-a-friend readable. Write is owner-only
      // too: a real mutual friendship is only ever created/removed via
      // the backend (POST /api/v1/social/add-friend, /unfriend), which
      // uses the Admin SDK and so bypasses this rule entirely on both
      // sides of the write — this owner-only client rule exists so a
      // signed-in user can still read (list) their own friends directly,
      // and defensively, not as the actual mechanism friendships get
      // created through.
      match /friends/{friendUid} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }

      // Badges (types/index.ts's Badge — includes the "profile" and
      // "archetype" summary docs the friend-view profile screen reads,
      // not just achievement badges) — THE one collection in this app
      // that's readable by someone other than its owner. Deliberately
      // narrow: real friends only (isFriend, defined above), never a
      // public or "any authenticated user" rule — archetype/streak/badge
      // data is the one thing this app is willing to show a friend, and
      // nothing here is ever a rupee figure (see app/social.py's own
      // header comment) or budget/cap/wallet/instance data, which all
      // stay on the untouched owner-only collections above. Write stays
      // owner-only — a badge is only ever earned/synced by the account
      // that earned it.
      match /badges/{badgeId} {
        allow read: if isOwner(userId) || isSuperAdmin() || isFriend(userId);
        allow write: if isOwner(userId) || isSuperAdmin();
      }
    }

    // Shared category taxonomy
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ML Predictions (written by backend server/Admin SDK, read-only to user)
    match /predictions/{userId}/{period=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isSuperAdmin(); // Server writes via Admin SDK (bypasses rules) or superadmin token
    }

    // Admin Beta Allowlist — Brief 2 (2026-09-04): was `if isAuthenticated()`,
    // meaning any signed-in account (including a brand-new public signup)
    // could read this document straight out of the browser console and get
    // every beta tester's email address in one call. The client no longer
    // needs to read this at all (see isBetaAllowlisted() above), so this is
    // now superadmin-only in both directions.
    match /admin/betaAllowlist {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Step 12: public-launch config. Readable by any authenticated user —
    // has to be, since a brand-new (possibly not-yet-allowlisted) sign-in
    // needs to read this doc to find out whether they're let in via the
    // public path, before we know anything else about them. Same read
    // posture as admin/betaAllowlist above for the same reason. Write is
    // superadmin-only. Deliberately its own doc, not folded into
    // admin/dataConfig (Step 10, superadmin-read-only ML training config) —
    // that doc's read rule is superadmin-only, which would make it
    // unreadable by exactly the users who need to check this flag.
    match /admin/launchConfig {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Public, anonymous spend survey (feeds ML training data).
    // No auth required to submit — respondents are teens filling out a
    // one-off form, not logged-in users. Write-only: nobody but a
    // superadmin can read, edit, or delete responses back out, so a
    // submission can't be enumerated, scraped, or tampered with after
    // the fact from the client.
    //
    // Step 10 (2026-08-21): this block was found already deployed live in
    // Firebase (ruleset 3bc866e4, created 2026-08-21T08:26:05Z by the
    // separate survey.antara.money project's own setup) but was NOT present
    // in this repo's firestore.rules — the repo file was out of sync with
    // what's actually enforced in production. Pulled it in verbatim here so
    // the repo stops lying about what's live, rather than silently leaving
    // the drift in place.
    function isValidSurveySubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly(
        ['schema_version', 'submitted_at', 'demographics', 'habits', 'category_spend', 'other_spend_note', 'beta_email', 'meta']
      )
        && d.schema_version is int
        && d.submitted_at == request.time
        && d.demographics is map
        && d.habits is map
        && d.category_spend is map
        && d.category_spend.size() <= 25
        && (d.other_spend_note == null || (d.other_spend_note is string && d.other_spend_note.size() <= 300))
        && (d.beta_email == null || (d.beta_email is string && d.beta_email.size() <= 200))
        && d.meta is map;
    }

    match /survey_responses/{responseId} {
      allow create: if isValidSurveySubmission();
      allow read, update, delete: if isSuperAdmin();
    }

    // Step 10: superadmin "tailor the data" config (income band cutoffs,
    // per-category trust weights, outlier handling, confidence threshold —
    // see backend/app/ml/survey_etl.py) and the computed Stage-1 training
    // stats it produces. Both superadmin-only in both directions — the
    // computed stats aren't public data, and only a superadmin should be
    // able to change what feeds the ML heuristic. The backend itself reads/
    // writes both via the Admin SDK, which bypasses these rules entirely;
    // they matter for the admin panel's direct client-side reads.
    match /admin/dataConfig {
      allow read, write: if isSuperAdmin();
    }
    match /admin/categoryBenchmarks {
      allow read, write: if isSuperAdmin();
    }

    // Brief 5 (2026-09-05): in-app feedback. Owner-create-only, same
    // "write-only from the client, superadmin reads it back" shape
    // survey_responses above already uses, but authenticated (not
    // anonymous) since this is real signed-in accounts reaching for a
    // profile-screen "send feedback" sheet, not a public survey — the
    // document is tied to the real uid that wrote it (checked against the
    // token, not trusted from the body) so a caller can't submit feedback
    // as someone else. No update/delete from the client at all — a
    // submitted note is immutable once sent, same posture as
    // survey_responses' own submissions.
    function isValidFeedback() {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'message', 'app_version', 'user_agent', 'submitted_at'])
        && d.keys().hasOnly(['uid', 'message', 'app_version', 'user_agent', 'submitted_at'])
        && d.uid == request.auth.uid
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
        && d.app_version is string && d.app_version.size() <= 40
        && d.user_agent is string && d.user_agent.size() <= 500
        && d.submitted_at is string;
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && isValidFeedback();
      allow read: if isSuperAdmin();
    }
  }
}
