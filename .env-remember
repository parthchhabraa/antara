# ==============================================================================
# ANTARA PERSISTENT STATE REMEMBER FILE
# NON-SECRET CONFIGURATION & SYSTEM ARCHITECTURE STATE
# DO NOT STORE API KEYS, SECRETS, OR SERVICE ACCOUNT PRIVATE KEYS HERE.
# Last updated: post-Step-9 pass (named Cloudflare tunnel + antara.money domain), 2026-08-21 on host "draftsmanbrain"
# NOTE: sections below dated "post-Step-6"/"Strain" are from 2026-08-20 and haven't been
# re-verified against Steps 7/8 (theme reverted violet, category taxonomy realigned to
# 18 survey-matched ids, ML endpoints revived) -- this pass only updated the Access-paths
# section below for the domain/tunnel/CORS work; treat the theme/category/ML paragraphs
# further down as stale until someone updates them too.
# ==============================================================================

# Project Metadata
PROJECT_NAME="Antara"
PROJECT_ID="antara-moneycontrol"
DEPLOYMENT_TARGET="Ubuntu Server (draftsmanbrain, bare metal home server)"
DEPLOYMENT_USER="parthchhabra"   # NOT root. Services run unprivileged.

# Repo / working tree location (differs from an earlier /root/antara assumption
# in .env-remember.template -- this box does not deploy as root)
REPO_PATH="/home/parthchhabra/antara-deploy/antara"
SECRETS_PATH="/home/parthchhabra/antara-deploy/secrets/serviceAccountKey.json"  # chmod 600, gitignored dir, outside repo

# Systemd units (all `systemctl status <name>`, all enabled for boot + Restart=on-failure)
SERVICE_BACKEND="antara-ml.service"          # uvicorn app.main:app, now 0.0.0.0:8001 (was 127.0.0.1-only)
SERVICE_FRONTEND="antara-frontend.service"   # next start -p 3001, binds all interfaces by Next's own default
SERVICE_TUNNEL="antara-tunnel.service"       # cloudflared quick tunnel -> 127.0.0.1:3001, public internet access
SERVICE_RESTART_CMD="sudo systemctl restart antara-ml.service antara-frontend.service antara-tunnel.service"

# Port Allocations (Strictly enforce no overlaps)
PORT_RESERVED_VANTAGECORE=8000   # existing vantageCore backend on this host (DO NOT TOUCH)
PORT_RESERVED_N8N=5678
PORT_RESERVED_OPEN_WEBUI=3000    # not 5000 as an earlier template assumed -- open-webui actually owns 3000
PORT_ANTARA_ML_API=8001          # Antara FastAPI ML backend. NOW BOUND TO 0.0.0.0 (see Access below)
PORT_ANTARA_FRONTEND=3001        # Next.js frontend. Bound to all interfaces by default (Next's own behavior)

# ── Access paths (four, by design) ──────────────────────────────────────────
# 1. Public internet, real domain, stable (Step 9, 2026-08-21):
DOMAIN="antara.money"   # registered on GoDaddy; DNS delegated to Cloudflare (zone active,
                         # confirmed propagated globally as of this pass -- see below)
PUBLIC_APP_URL="https://app.antara.money"    # frontend, routed through the named tunnel
PUBLIC_API_URL="https://api.antara.money"    # backend, routed through the same named tunnel
SURVEY_URL="https://survey.antara.money"     # separate GitHub Pages site, NOT this repo/host --
                                              # user's own project, added as a CNAME by them.
                                              # Confirmed resolving + serving real content this pass.
CLOUDFLARE_TUNNEL_NAME="antara-prod"
CLOUDFLARE_TUNNEL_ID="66954aab-7c3c-4d75-bef3-b684202d9829"
CLOUDFLARE_TUNNEL_CONFIG="/home/parthchhabra/.cloudflared/config.yml"   # ingress: app.antara.money
                                              # -> localhost:3001, api.antara.money -> localhost:8001
CLOUDFLARE_TUNNEL_CERT="/home/parthchhabra/.cloudflared/cert.pem"       # cloudflared tunnel login,
                                              # scoped to the antara.money zone in the user's Cloudflare account
CLOUDFLARE_ZONE_NAMESERVERS="julissa.ns.cloudflare.com, peter.ns.cloudflare.com"
# This REPLACES the old Cloudflare Quick Tunnel (--url flag, rotating trycloudflare.com
# hostname) that antara-tunnel.service ran through Step 8. Same systemd unit name,
# now runs `cloudflared --config .../config.yml --no-autoupdate tunnel run antara-prod`
# instead -- a stable named tunnel, not a quick tunnel. IMPORTANT flag-order gotcha hit
# and fixed this pass: `--no-autoupdate` and `--config` must both come BEFORE `tunnel run
# <name>` on the command line, or cloudflared rejects it with "tunnel run accepts only
# one argument" (looks like a naming/subcommand error, isn't one).
# DNS propagation note: confirmed via 3 independent public resolvers (8.8.8.8, 1.1.1.1,
# 9.9.9.9) that antara.money's NS delegation to Cloudflare is live, and both
# app.antara.money/api.antara.money resolve to real Cloudflare edge IPs and return real
# app responses (not Cloudflare error pages) -- verified with `curl --resolve` since this
# box's OWN default resolver (via its LAN router, 192.168.0.1) was still serving a stale
# cached NS answer as of this pass and may take longer to catch up locally; that's a
# local-cache lag on this one machine, not a real propagation problem -- don't be alarmed
# if a plain `curl https://app.antara.money` from THIS box specifically still fails to
# resolve for a while after this was written, from literally anywhere else it already works.
#
# 2. Tailscale tailnet, private, stable IP, no public tunnel dependency -- STILL ACTIVE,
#    kept as a fallback per explicit instruction, NOT replaced by the domain:
TAILSCALE_IP="100.103.94.116"                     # this host's tailnet address, doesn't change
TAILSCALE_APP_URL="http://100.103.94.116:3001"    # the actual Antara app UI
TAILSCALE_BACKEND_URL="http://100.103.94.116:8001" # raw FastAPI backend (health check, ML endpoints directly)
TAILSCALE_ACCESS_NOTE="Backend was 127.0.0.1-only; changed ExecStart in
  /etc/systemd/system/antara-ml.service to --host 0.0.0.0 so it's reachable
  tailnet-wide, same as the frontend already was. Only reachable from devices
  on this Tailscale tailnet (phone/iPad/MacBook already authorized) or this
  host's own LAN (192.168.0.x) -- never exposed to the public internet, no
  port forwarding configured on the router. Re-verified working after the
  Step 9 domain/tunnel work landed -- both frontend and backend still respond
  on the Tailscale IP exactly as before; nothing about the domain setup
  touches or depends on this path."
#
# 3. Direct LAN IP (bonus, same 0.0.0.0 binding as #2): http://192.168.0.8:3001 / :8001
#
# 4. Local dev on this box: relative paths via the Next.js rewrite (see ARCHITECTURE_NOTE)
#
ARCHITECTURE_NOTE="Frontend calls the backend two different ways depending on how it was
  built, both still supported (Step 9): if NEXT_PUBLIC_API_BASE_URL is set at build time
  (frontend/.env.local -- currently 'https://api.antara.money' for this box's production
  build), lib/api.ts's fetchSpendPrediction() calls that absolute URL directly, a genuine
  cross-origin browser request -- this is why CORS in backend/app/main.py had to become a
  real explicit allowlist (ALLOWED_ORIGINS) instead of '*': the old wildcard only ever
  'worked' because every real call used to go through the rewrite below, making it
  same-origin and never actually exercising CORS. If NEXT_PUBLIC_API_BASE_URL is unset
  (local dev), the URL is relative ('/api/v1/predict/spend') and goes through
  frontend/next.config.js's rewrite (-> http://127.0.0.1:8001/*) exactly as before Step 9 --
  same-origin, no CORS involved, works with zero domain/DNS dependency for local testing.
  CORS_ALLOWED_ORIGINS now explicitly includes: https://app.antara.money,
  https://antara.money, both Tailscale URLs (:3001 and :8001), both LAN URLs, and
  localhost:3000/3001 dev origins -- nothing that worked before was narrowed."
TAILSCALE_STATUS="Active - independent daemon, no port overlap. Confirmed still working
  end-to-end after the Step 9 domain work (frontend 200, backend /health 200)."
IPV4_FIX="enp8s0 netplan had no dhcp4 stanza (only IPv6 SLAAC worked). Added dhcp4:true to /etc/netplan/00-installer-config.yaml + `netplan apply`. Backup at /etc/netplan/00-installer-config.yaml.bak-*"

# ── Product redesign: "Strain" (post Step-6) ────────────────────────────────
# Implemented a full-app redesign from a Claude Design mockup (project "Paintball
# site redesign", c1d04464-8ef0-4fa5-8a30-df5afd5a3395, file Antara.dc.html,
# concept "1a - Strain"), approved by the user as a full replacement, not an
# additional screen:
#   - Home ("/"): Whoop-style daily burn-rate gauge (BurnGauge.tsx) replacing the
#     old monthly-budget-% dashboard; folds in what /predict used to show
#     (run-out date, coach line, category risk rows). /predict route deleted.
#   - Pull ("/graph", same route path, new content): two-pole need/want physics
#     canvas (PullCanvas.tsx) replacing the old category-radial ML dot graph
#     (DotGraphCanvas.tsx, deleted). Pure client-side math from is_essential,
#     NOT calling the backend's ML prediction/dot-graph endpoints anymore.
#   - Quick-log: full numeric keypad sheet (QuickLogSheet.tsx) replacing the old
#     amount-field + chips modal (QuickLogModal.tsx, deleted).
#   - New shared components: BurnGauge, PullCanvas, QuickLogSheet,
#     CategoryDetailSheet, CategoryIcon, CountUpNumber, PageTransition.
#   - Deleted as superseded/orphaned: predict/page.tsx, QuickLogModal.tsx,
#     DotGraphCanvas.tsx, BudgetRing.tsx, PredictiveInsightsCard.tsx,
#     TransactionList.tsx.
# CONSEQUENCE: the backend's /api/v1/predict/spend and /api/v1/ml/dot-graph
# endpoints (cold-start heuristic / trained embedding / peer archetypes) are no
# longer called by any frontend code as of this pass -- removed the now-dead
# client code that called them (fetchSpendPredictions, fetchDotGraphData,
# calculateDataMaturity, computeClientSidePrediction, computeClientSideDotGraph
# in lib/api.ts, plus the SpendPrediction/DotGraphData/GraphNode/GraphLink/
# PeerArchetype/CategoryForecast types). The backend endpoints themselves are
# untouched and still work if something is pointed at them directly -- they're
# just unused by this app right now. Category taxonomy (STARTER_CATEGORIES)
# unchanged and still the single source of truth Firestore/rules/backend key on;
# the mockup's own parallel category list (different ids) was NOT adopted.
# New per-category fields added: Category.short (chip label), Category.monthly_cap
# (soft per-category budget, hardcoded, not yet user-editable).

# ── Theme: emerald + gold (post Step-6) ─────────────────────────────────────
# Replaced the original violet/indigo/cyan "gamer app" palette with a deep
# emerald green (financial trust/safety) primary + a restrained metallic gold
# for premium/status accents, same near-black base as before. tailwind.config.ts
# `primary` token now IS emerald (was violet); new `gold` token added. Signature
# CTA gradient changed from purple->indigo->cyan to emerald->emerald->gold
# across sign-in button, Log button, "Show me the plan", keypad commit button,
# logo badge. Canvas/SVG hardcoded hex colors (BurnGauge stroke gradient,
# PullCanvas want-pole color, globals.css scrollbar hover) updated to match.
# Category icon colors (the 12-category data-viz palette in constants.ts) were
# deliberately left untouched -- that's category differentiation, not brand
# theme. The "hot/over-budget" warning gradient (rose->amber) also left as-is
# -- that's semantic danger-state color, not brand identity.

# ML Pipeline & Cold-Start Rules (backend-side only now, see redesign note above)
ML_COLD_START_DAY_THRESHOLD=14
ML_MODEL_MODE_HEURISTIC="HEURISTIC_COLD_START"
ML_MODEL_MODE_TRAINED="TRAINED_EMBEDDING_V1"

# Firebase & Database State
FIRESTORE_SCHEMA_VERSION="v1"
COLLECTION_USERS="users"
COLLECTION_USER_TRANSACTIONS="transactions"
COLLECTION_CATEGORIES="categories"
COLLECTION_PREDICTIONS="predictions"
DOC_BETA_ALLOWLIST="admin/betaAllowlist"   # doc shape: { emails: string[], entries: BetaAllowlistEntry[] }.
                                            # `emails` is what firestore.rules checks (cheap membership test);
                                            # `entries` carries added_at/added_by metadata for the /admin UI.
                                            # Both are written together by SuperadminPanel.tsx on every add/remove.
BETA_ALLOWLIST_ENFORCEMENT="Firestore rules require isSuperAdmin() OR (isOwner + email in admin/betaAllowlist.emails) to write users/{uid}/transactions/*. Client-side gate in AuthContext also blocks non-allowlisted Google sign-ins from reaching Live Mode."
BETA_ALLOWLIST_CURRENT_EMAILS="parthchhabra6112@gmail.com (superadmin, auto-seeded), parth612chhabra@gmail.com (added 2026-08-20, more to follow). Live block test with a NON-allowlisted account still pending -- everything added so far is allowlisted, need a third account that isn't to actually test the block."

