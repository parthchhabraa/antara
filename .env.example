# ==============================================================================
# ANTARA ENVIRONMENT TEMPLATE (.env.example)
# Copy to frontend/.env.local and backend/.env as required
# ==============================================================================

# Frontend Firebase Web SDK (Public configuration)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="antara-moneycontrol.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="antara-moneycontrol"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="antara-moneycontrol.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="709322007995"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"

# ML Backend API URL (Port 8001 locally or Cloudflare tunnel in prod)
NEXT_PUBLIC_ML_API_URL="http://localhost:8001"

# Backend Firebase Admin SDK
FIREBASE_PROJECT_ID="antara-moneycontrol"
# Either provide path to service account json or service account json string
GOOGLE_APPLICATION_CREDENTIALS="/path/to/serviceAccountKey.json"
PORT=8001
ENVIRONMENT="development"
